# ==============================================================================
# RAAMBOW CLIENT MANAGEMENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT SECURITY GUIDELINES:
# 1. Never commit your real .env file or production secrets to Git.
# 2. Never use default development secrets in staging or production.
# 3. Generate a strong 32+ character random string for JWT_SECRET.
#    You can generate one using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION A: Local Development with SQLite (Default - zero setup required)
# Runs out-of-the-box using the bundled SQLite database in prisma/dev.db
DATABASE_URL="file:./dev.db"

# OPTION B: Production / Staging with PostgreSQL (Supabase, Neon, AWS RDS, Railway)
# When deploying to production with PostgreSQL:
# 1. Set DATABASE_URL to your connection pooling URL (Transaction mode, port 6543 on Supabase)
# 2. Set DIRECT_URL to your direct connection URL (Session mode, port 5432 on Supabase)
# 3. Switch Prisma provider using: npm run db:mode:postgres
# 4. Deploy migrations using: npx prisma migrate deploy (or npm run db:push)
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Mandatory 32+ character cryptographically secure secret used to sign JWT cookies.
# In production, the application will refuse to start if this is missing or empty.
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"

# ------------------------------------------------------------------------------
# 4. PUBLIC APPLICATION BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RaamBow Client Management"
NEXT_PUBLIC_COMPANY_NAME="RaamBow TechSolutions"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
