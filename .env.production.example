# ==============================================================================
# RAMBOOW CLIENT MANAGEMENT — PRODUCTION ENVIRONMENT CONFIGURATION
# Company: Ramboow TechSolutions
# ==============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# Configure these variables in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Recommended Region: ap-south-1 (Mumbai, India) on Supabase, Neon, or AWS RDS
#
# DATABASE_URL: Pooled connection string (pgBouncer / Supabase pooler / Neon pooler)
# Used by Next.js serverless functions for high-concurrency client queries.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection string (Port 5432)
# Used exclusively for schema migrations (npx prisma migrate deploy).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character secret with:
# openssl rand -base64 48
JWT_SECRET="GENERATE_STRONG_RANDOM_SECRET_DO_NOT_USE_DEFAULT"

# ------------------------------------------------------------------------------
# 3. APPLICATION & DOMAIN BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RaamBow Client Management"
NEXT_PUBLIC_COMPANY_NAME="RaamBow TechSolutions"

# Configurable Production Domain (e.g. https://crm.raambow.com or https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL="https://crm.raambow.com"

# Set NODE_ENV to production
NODE_ENV="production"

