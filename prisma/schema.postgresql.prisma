// Prisma schema for Ramboow Client Management
// Production configuration for Managed Cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS in India region)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String        @id @default(uuid())
  name           String
  username       String?       @unique
  email          String        @unique
  phone          String?
  passwordHash   String
  role           String        @default("TEAM_MEMBER") // ADMIN or TEAM_MEMBER
  approvalStatus String        @default("APPROVED") // PENDING, APPROVED, REJECTED
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignedClients Client[]    @relation("AssignedClients")
  callHistories   CallHistory[]
  followUps       FollowUp[]
  auditLogs       AuditLog[]
  importHistories ImportHistory[]

  @@index([approvalStatus])
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  clients     Client[]
}

model Client {
  id             String        @id @default(uuid())
  name           String
  phone          String        @unique
  email          String?
  companyName    String?
  company        String        @default("RAAMBOW") // RAAMBOW or KATERNGERS
  location       String?
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?         @relation("AssignedClients", fields: [assignedToId], references: [id], onDelete: SetNull)
  status         String        @default("NEW") // NEW, INTERESTED, FOLLOW_UP, FUTURE, THINKING, NOT_INTERESTED, NO_RESPONSE, CONVERTED, LOST
  notes          String?
  expectedStart  String?       // For FUTURE clients: e.g. "January 2027", "2027-01-15"
  futureReason   String?       // For FUTURE clients: Reason for future interest / delayed start
  // Project Quotation & Converted Client Management (Admin Only)
  quotationAmount Float?       // Agreed quotation / fixed project price
  quotationDetails String?      // Scope / quotation notes
  advanceReceived Float?       // Advance payment received
  balancePayment Float?       // Balance payment remaining
  paymentStatus  String?       @default("PENDING") // PENDING, PARTIAL, COMPLETED
  projectStarted DateTime?     // Project start date
  projectDeadline DateTime?    // Project deadline
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  callHistories  CallHistory[]
  followUps      FollowUp[]

  @@index([status])
  @@index([phone])
  @@index([company])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
}

model CallHistory {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  callResult     String    // CONNECTED, NO_RESPONSE, BUSY, CALL_LATER, WRONG_NUMBER, MEETING_SCHEDULED, OTHER
  notes          String
  statusAtTime   String    // Legacy snapshot of client status at the time of call
  previousStatus String?   // Explicit previous status before this update
  newStatus      String?   // Explicit new status set in this update
  calledAt       DateTime  @default(now())
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([calledAt])
}

model FollowUp {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  notes       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([completed])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ImportHistory {
  id           String   @id @default(uuid())
  fileName     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  totalRows    Int
  importedRows Int
  skippedRows  Int
  failedRows   Int
  status       String   @default("COMPLETED") // COMPLETED, PARTIAL, FAILED
  errorLog     String?  // JSON stringified row errors
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([createdAt])
}

